# ALANET external encrypted backup configuration.
# Copy to /etc/alanet/external-backup.env on production and chmod 600.
#
# Required for any external backup:
# ALANET_BACKUP_ENCRYPTION_PASSPHRASE must be a long random passphrase.
# Store it in a password manager; without it encrypted backups cannot be restored.
ALANET_BACKUP_ENCRYPTION_PASSPHRASE=

# Local backup retention on production VPS.
ALANET_LOCAL_RETENTION_DAYS=7

# External backup retention for filesystem-compatible target.
ALANET_EXTERNAL_RETENTION_DAYS=90

# Option A: mounted external storage or a temporary local integration-test directory.
ALANET_BACKUP_EXTERNAL_DIR=

# Option B: rclone remote. Recommended for Timeweb Cloud S3.
# Example after creating /etc/alanet/rclone.conf with [timeweb]:
# ALANET_BACKUP_RCLONE_DEST=timeweb:<bucket>/alanet/prod
# Note: alanet-backup currently calls rclone from systemd/root environment.
# If you store rclone config outside the default root path, export RCLONE_CONFIG
# in /etc/alanet/external-backup.env.
ALANET_BACKUP_RCLONE_DEST=
RCLONE_CONFIG=/etc/alanet/rclone.conf

# Option C: AWS CLI / S3-compatible URI, for example s3://alanet-prod-backups/prod.
# Requires aws CLI credentials/environment for root/systemd user.
ALANET_BACKUP_S3_URI=

# Optional overrides.
ALANET_BACKUP_DIR=/var/backups/alanet
ALANET_MONITOR_DIR=/var/lib/alanet-monitor
ALANET_DEPLOY_ENV=/opt/alanet/deploy/.env
